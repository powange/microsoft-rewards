{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewards Autoplay",
  "version": "0.2.11",
  "identifier": "com.powange.rewardsautoplay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rewards Autoplay",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RUY3MjNGQjNDM0U4QkMKUldTODZNT3pQM0x2ZFNjcFU0KzVqM0MvSG0xZjF0UEhKQUZnT2xXMHpTUWErV3FhUXFmQWcwMEsK",
      "endpoints": [
        "https://github.com/powange/microsoft-rewards/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
